{
	"breadcrumbs.filePath": "off",
	"breadcrumbs.icons": false,
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "always"
	},
	"editor.detectIndentation": false,
	"editor.fontFamily": "'JetBrainsMono Nerd Font Mono', 'SauceCodePro Nerd Font Mono', 'monospace', monospace",
	"editor.insertSpaces": false,
	"editor.minimap.enabled": false,
	"editor.scrollBeyondLastLine": false,
	"editor.stickyScroll.enabled": false,
	"editor.wordWrapColumn": 120,
	"explorer.compactFolders": false,
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"files.exclude": {
		"**/.vscode": true,
		"**/*.js.map": true
	},
	"files.trimTrailingWhitespace": true,
	"json.schemas": [


	],
	"launch": {
		"configurations": [],
		"compounds": []
	},
	"security.workspace.trust.untrustedFiles": "open",
	"telemetry.telemetryLevel": "off",
	"terminal.integrated.accessibleViewPreserveCursorPosition": true,
	"terminal.integrated.fontSize": 13,
	"terminal.integrated.cursorBlinking": true,
	"terminal.integrated.lineHeight": 1.2,
	"terminal.integrated.tabs.title": "${cwdFolder}",
	"terminal.integrated.tabStopWidth": 4,
	"workbench.colorCustomizations": {},
	"workbench.colorTheme": "Dracula Dark",
	"workbench.editor.centeredLayoutFixedWidth": true,
	"workbench.editor.tabSizing": "fixed",
	"workbench.iconTheme": "material",
	"workbench.startupEditor": "newUntitledFile",
	"workbench.editor.tabSizingFixedMaxWidth": 250,
	"workbench.editor.tabSizingFixedMinWidth": 110,
	"[html]": {
		"editor.defaultFormatter": "vscode.html-language-features"
	},
	"[javascript]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[typescript]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"better-comments.tags": [
			{
			"tag": "TODO",
			"color": "#000000",
			"backgroundColor": "#FF8C00",
			"bold": true,
			"italic": false,
			"underline": false,
			"strikethrough": false,
		},
		{
			"tag": "FIXME",
			"color": "#000000",
			"backgroundColor": "#FF2D00",
			"bold": true,
			"italic": false,
			"underline": false,
			"strikethrough": false,
		},
		{
			"tag": "? ",
			"color": "#000000",
			"backgroundColor": "#3498DB",
			"bold": true,
			"italic": false,
			"underline": false,
			"strikethrough": false,
		},
		{
			"tag": "! ",
			"color": "#000000",
			"backgroundColor": "#FF2D00",
			"bold": true,
			"italic": false,
			"underline": false,
			"strikethrough": false,
		},
		{
			"tag": "* ",
			"color": "#98C379",
			"backgroundColor": "transparent",
			"bold": false,
			"italic": false,
			"underline": false,
			"strikethrough": false,
		}
	],
	"docthis.inferTypesFromNames": true,
	"eslint.run": "onType",
	"eslint.validate": [
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact",
	],
	"fiveServer.highlight": true,
	"fiveServer.host": "127.0.0.1",
	"flake8.args": [
		"--ignore=E501"
	],
	"git.openRepositoryInParentFolders": "never",
	"highlightOnCopy.timeout": 100,
	"javascript.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": false,
	"javascript.format.semicolons": "insert",
	"prettier.printWidth": 120,
	"prettier.tabWidth": 4,
	"projectManager.any.maxDepthRecursion": 3,
	"projectManager.git.baseFolders": [
		"/home/matt/Projects/repos"
	],
	"projectManager.git.maxDepthRecursion": 3,
	"projectManager.groupList": true,
	"projectManager.hg.maxDepthRecursion": 3,
	"projectManager.showParentFolderInfoOnDuplicates": true,
	"projectManager.sortList": "Name",
	"projectManager.svn.ignoredFolders": [
		"node_modules",
		"out",
		"typings",
		"test",
		"__pycache__"
	],
	"projectManager.svn.maxDepthRecursion": 3,
	"projectManager.tags": [],
	"projectManager.vscode.baseFolders": [
		"/home/matt/projects"
	],
	"projectManager.vscode.maxDepthRecursion": 3,
	"python.experiments.optOutFrom": [
		"All"
	],
	"redhat.telemetry.enabled": false,
	"shellcheck.exclude": [
		"1071"
	],
	"shellcheck.ignorePatterns": {
		"**/.config/zsh/**/*": false
	},
	"sync.gist": "a0bd4c2f77f09bbe29249c2b610815a0",
	"typescript.format.insertSpaceAfterTypeAssertion": true,
	"typescript.surveys.enabled": false,
	"typescript.validate.enable": true,
	"editor.autoClosingBrackets": "never",
	"editor.autoClosingQuotes": "never",
	"fiveServer.openTerminal": false,
	"window.commandCenter": false,
	"[plaintext]": {
		"editor.wordWrap": "on"
	},
	"basedpyright.analysis.typeCheckingMode": "standard",
	"basedpyright.analysis.inlayHints.variableTypes": false,
	"editor.fontSize": 15,
	"basedpyright.analysis.inlayHints.genericTypes": true,
	"basedpyright.disableTaggedHints": true,
	"basedpyright.analysis.inlayHints.callArgumentNames": false,
	"python.terminal.launchArgs": [],
	"python.analysis.autoImportCompletions": true,
	"python.analysis.inlayHints.pytestParameters": true,
	"python.analysis.inlayHints.functionReturnTypes": true,
	"python.analysis.inlayHints.variableTypes": true,
	"python.analysis.includeAliasesFromUserFiles": true,
	"bookmarks.saveBookmarksInProject": true,
	"workbench.editor.preventPinnedEditorClose": "keyboard",
}