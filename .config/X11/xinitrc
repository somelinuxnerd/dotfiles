#!/bin/sh

# Fix CapsLock key behavior
if command -v xmodmap >/dev/null; then
	if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}"/X11/xmodmap ]; then
		xmodmap "${XDG_CONFIG_HOME:-$HOME/.config}"/X11/xmodmap &
	else
		xmodmap -e 'clear lock' -e 'keycode 66 = NoSymbol Caps_Lock NoSymbol NoSymbol' &
	fi
elif command -v setxkbmap >/dev/null; then
	setxkbmap -option "terminate:ctrl_alt_bksp,caps:escape_shifted_capslock" &
fi

# Set keyboard repeat rate
if command -v xset >/dev/null; then
	xset r rate 500 30
fi

# Load XResources
if command -v xrdb >/dev/null && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}"/X11/xresources ]; then
	xrdb -merge "${XDG_CONFIG_HOME:-$HOME/.config}"/X11/xresources &
fi

# Disable touchscreen
if command -v touchscreen >/dev/null; then
	touchscreen -d &
fi

# Disable touchpad
#if command -v touchpad >/dev/null; then
#	touchpad -d &
#fi

# Disable keyboard
#if command -v keyboard >/dev/null; then
#	keyboard -d &
#fi

# Start Desktop Session
if command -v cinnamon-session >/dev/null; then
	exec cinnamon-session
elif command -v startxfce4 >/dev/null; then
	exec startxfce4
fi





