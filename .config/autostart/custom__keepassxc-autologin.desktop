[Desktop Entry]
Type=Application
Name=KeePassXC (autologin)
Comment=Launches KeePassXC and logs in if password is in the keyring
Exec=/bin/sh -c "$HOME/Scripts/launch-keepassxc"
Icon=keepassxc
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=4
Hidden=false
NoDisplay=false
Name[en_US]=KeePassXC Auto-login
